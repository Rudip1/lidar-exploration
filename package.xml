<?xml version="1.0"?>
<package format="2">
  <name>lidar_based_exploration</name>
  <version>0.1.0</version>
  <description>
    Autonomous exploration for a TurtleBot (Kobuki) with a 2D LiDAR: information-gain
    goal sampling, Dubins RRT* path planning and pure pursuit path tracking.
  </description>

  <!-- TODO: replace the placeholder address with a public contact address. -->
  <maintainer email="maintainer@example.com">Gebrecherkos Gebrezgabhier</maintainer>
  <license>Apache-2.0</license>

  <author>Gebrecherkos Gebrezgabhier</author>
  <author>Pravin Oli</author>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>message_runtime</exec_depend>
  <exec_depend>laser_geometry</exec_depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-pil</exec_depend>
</package>
